@startuml

top to bottom direction
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam linetype ortho

package "crates/so3" {
    class Main <<bin>> {
        +main()
        +run()
    }
}

package "crates/so3-maelstrom" {
    class Runtime <<adapter>> {
        +run()
        -execute_leader_command()
        -handle_forward()
        -handle_consensus()
    }

    class MaelstromService {
        +prepare_command()
        +response_from_result()
    }
}

package "crates/core::node" {
    class Node {
        -config: NodeConfig
        -object_server: ObjectServer
        -rpc_server: RpcServer
        -object_service: ObjectService
        +new(config): Result<Node>
        +bind(): Result<BoundNode>
        +run(cancellation_token): Result<()>
    }

    class BoundNode {
        -object_listener: TcpListener
        -rpc_listener: TcpListener
        +run(cancellation_token): Result<()>
    }

    class NodeConfig {
        +node_id: Uuid
        +object_api_addr: SocketAddr
        +rpc_api_addr: SocketAddr
        +metadata_dir: PathBuf
        +blob_dir: PathBuf
        +cluster: ClusterConfig
        +validate(): Result<()>
    }

    class ClusterConfig {
        +peers: Vec<SocketAddr>
    }
}

package "crates/core::object_server" {
    class ObjectServer {
        +run(listener, config, service, cancellation_token): Result<()>
    }

    class ObjectService {
        -executor: ObjectCommandExecutor
        +read(key): Result<Option<StoredObject>>
        +write(key, value): Result<StoredObject>
        +cas(key, expected_version, value): Result<CasResult>
        +execute_command(command): Result<ObjectResult>
    }

    class ObjectApiState
    class ApiError
}

package "crates/core::domain" {
    class ObjectKey
    class ObjectVersion

    class ObjectRecord {
        +key: ObjectKey
        +version: ObjectVersion
        +blob_id: String
        +content_length: u64
        +checksum: String
    }

    class StoredObject {
        +record: ObjectRecord
        +value: Vec<u8>
    }

    enum ObjectCommand {
        Read
        Write
        Cas
    }

    enum ObjectResult {
        Read
        Write
        Cas
    }

    enum CasResult {
        Applied
        NotFound
        Mismatch
    }

    class So3Error
}

package "crates/core::consensus" {
    interface ObjectCommandExecutor {
        +execute_command(command): Result<ObjectResult>
    }

    class LocalStateMachine {
        -repository: ObjectRepository
        +execute(command): Result<ObjectResult>
    }

    class LocalConsensusObjectCommandExecutor {
        -local_transport: ConsensusTransportHandler
        -peer_transport: TonicConsensusPeerTransport
        -next_sequence: AtomicU64
        +execute_command(command): Result<ObjectResult>
    }

    class AccordCoordinator {
        -local_transport: ConsensusTransportHandler
        -peer_transport: ConsensusPeerTransport
        -clock: HybridLogicalClock
        +execute(command_id, command): Result<ObjectResult>
        +recover(command_id, ballot): Result<RecoveryDecision>
    }

    interface ConsensusPeerTransport {
        +pre_accept_peer()
        +accept_peer()
        +commit_peer()
        +recover_peer()
    }

    class PersistentReplicatedCommandExecutor {
        -state_machine: LocalStateMachine
        -applied_command_store: AppliedCommandStore
        +execute_replicated(command_id, command): Result<ObjectResult>
    }

    interface ReplicatedCommandExecutor {
        +execute_replicated(command_id, command): Result<ObjectResult>
    }

    class SqliteConsensusJournal {
        +record_pre_accepted()
        +record_accepted()
        +record_committed()
        +record_applied()
        +list_by_state()
        +next_sequence_for_origin()
    }

    enum JournalState {
        PreAccepted
        Accepted
        Committed
        Applied
    }

    class HybridLogicalClock
    class ConsensusCommandId
}

package "crates/core::rpc_server" {
    class RpcServer {
        -handler: ConsensusTransportHandler
        +run(listener, cancellation_token): Result<()>
    }

    interface ConsensusTransportHandler {
        +pre_accept()
        +accept()
        +commit()
        +apply()
        +recover()
    }

    class ApplyingConsensusTransport {
        -executor: ReplicatedCommandExecutor
        -journal: SqliteConsensusJournal
        -clock: HybridLogicalClock
    }

    class TonicConsensusPeerTransport {
        -peers: HashMap<String, ConsensusTransportClient>
    }

    class ConsensusTransportService <<tonic service>>
    class ConsensusTransportClient <<generated client>>
    class ConsensusTransportServer <<generated server>>
}

package "crates/core::storage" {
    class PersistentStorage {
        +metadata_repository: SqliteObjectMetadataRepository
        +object_repository: SqliteFsPersistentObjectRepository
        +consensus_journal: SqliteConsensusJournal
        +open(metadata_dir, blob_dir): Result<PersistentStorage>
    }

    interface ObjectRepository {
        +read(key): Result<Option<StoredObject>>
        +write(key, value): Result<StoredObject>
        +cas(key, expected_version, value): Result<CasWriteOutcome>
    }

    class PersistentObjectRepository {
        -metadata_repository: ObjectMetadataRepository
        -blob_repository: BlobRepository
        -write_lock: Mutex
    }

    interface ObjectMetadataRepository
    interface AppliedCommandStore
    class SqliteObjectMetadataRepository
    interface BlobRepository
    class FileSystemBlobRepository
}

Main --> NodeConfig : loads
Main --> Node : starts
Node *-- NodeConfig
Node *-- ObjectServer
Node *-- RpcServer
Node *-- ObjectService
Node ..> PersistentStorage : opens
Node ..> ApplyingConsensusTransport : local RPC handler
Node ..> TonicConsensusPeerTransport : peer clients
NodeConfig o-- ClusterConfig

ObjectServer --> ObjectApiState
ObjectServer --> ObjectService
ObjectService --> ObjectCommandExecutor
ObjectService ..> ObjectCommand
ObjectService ..> ObjectResult

LocalConsensusObjectCommandExecutor ..|> ObjectCommandExecutor
LocalConsensusObjectCommandExecutor --> AccordCoordinator
LocalConsensusObjectCommandExecutor --> TonicConsensusPeerTransport
AccordCoordinator --> ConsensusTransportHandler : local phases
AccordCoordinator --> ConsensusPeerTransport : peer phases
TonicConsensusPeerTransport ..|> ConsensusPeerTransport
TonicConsensusPeerTransport --> ConsensusTransportClient

RpcServer --> ConsensusTransportServer
ConsensusTransportServer --> ConsensusTransportService
ConsensusTransportService --> ConsensusTransportHandler
ApplyingConsensusTransport ..|> ConsensusTransportHandler
ApplyingConsensusTransport --> SqliteConsensusJournal
ApplyingConsensusTransport --> ReplicatedCommandExecutor

PersistentReplicatedCommandExecutor ..|> ReplicatedCommandExecutor
PersistentReplicatedCommandExecutor --> LocalStateMachine
PersistentReplicatedCommandExecutor --> AppliedCommandStore
LocalStateMachine ..|> ObjectCommandExecutor
LocalStateMachine --> ObjectRepository

PersistentStorage *-- SqliteObjectMetadataRepository
PersistentStorage *-- PersistentObjectRepository
PersistentStorage *-- SqliteConsensusJournal
PersistentObjectRepository ..|> ObjectRepository
PersistentObjectRepository --> ObjectMetadataRepository
PersistentObjectRepository --> BlobRepository
SqliteObjectMetadataRepository ..|> ObjectMetadataRepository
SqliteObjectMetadataRepository ..|> AppliedCommandStore
FileSystemBlobRepository ..|> BlobRepository
SqliteConsensusJournal --> JournalState

ObjectCommand --> ObjectKey
ObjectCommand --> ObjectVersion
ObjectResult --> StoredObject
CasResult --> StoredObject
StoredObject *-- ObjectRecord
ObjectRecord --> ObjectKey
ObjectRecord --> ObjectVersion
ApiError --> So3Error

Runtime --> MaelstromService
Runtime --> AccordCoordinator : leader path
Runtime --> ApplyingConsensusTransport : local consensus RPC
Runtime ..> PersistentStorage : per Maelstrom node
MaelstromService ..> ObjectCommand
MaelstromService ..> ObjectResult

note right of Node
Production node composition:
- HTTP object API
- private tonic RPC API
- local applying transport
- tonic peer transport
- durable replay before serving
end note

note right of AccordCoordinator
Current Accord prototype:
- PreAccept / Accept / Commit / Recover
- majority quorum for PreAccept and Accept
- unanimous fast path skips Accept
- commit broadcast is best effort
- client success waits for local applied result
end note

note right of PersistentStorage
Durability:
- SQLite metadata and applied results
- SQLite consensus journal
- immutable filesystem blobs
- blob is placed before metadata references it
end note

@enduml
