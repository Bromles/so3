@startuml

left to right direction
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam linetype ortho

package "crates/so3" {
    class main <<bin>> {
        +main()
        -run()
    }

    class config {
        +load_node_config(): NodeConfig
    }
}

package "crates/core::node" {
    class Node {
        -config: NodeConfig
        -object_use_case: Arc<ObjectUseCaseImpl>
        -inbound_consensus_use_case: Arc<InboundConsensusUseCaseImpl>
        -blob_use_case: Arc<BlobUseCaseImpl>
        +new(config): Result<Node>
        +bind(): Result<BoundNode>
        +run(cancellation_token): Result<()>
    }

    class BoundNode {
        -object_listener: TcpListener
        -rpc_listener: TcpListener
        +config(): &NodeConfig
        +run(cancellation_token): Result<()>
    }

    class NodeConfig {
        +node_id: Option<Uuid>
        +object_api_addr: SocketAddr
        +rpc_api_addr: SocketAddr
        +object_request_timeout: Duration
        +metadata_dir: PathBuf
        +blob_dir: PathBuf
        +cluster: ClusterConfig
        +validate(): Result<()>
    }

    class ClusterConfig {
        +peers: Vec<PeerConfig>
    }

    class PeerConfig {
        +node_id: Uuid
        +addr: SocketAddr
    }
}

package "crates/core::api" {
    class AxumS3Server {
        +start(listener, config, token): Result<()>
    }

    class ObjectApiController {
        +router(): Router
        -handle_s3_get()
        -handle_s3_head()
        -handle_s3_put()
        -handle_s3_delete()
    }

    class TonicRpcServer {
        +start(listener, token, inbound, blob): Result<()>
    }

    class ConsensusTransportService <<tonic>> {
        +pre_accept()
        +accept()
        +commit()
        +apply()
        +recover()
    }

    class BlobService <<tonic>> {
        +store_blob(stream)
        +fetch_blob(request)
    }
}

package "crates/core::use_case" {
    class ObjectUseCaseImpl {
        +head(key): Result<Option<ObjectMetadata>>
        +read(key): Result<Option<StoredObject>>
        +write(key, body): Result<ObjectMetadata>
        +delete(key): Result<()>
        +cas(key, expected_version, body): Result<CasResult>
    }

    class InboundConsensusUseCaseImpl {
        +pre_accept(req): Result<PreAcceptResponse>
        +accept(req): Result<AcceptResponse>
        +commit(req): Result<CommitResponse>
        +apply(req): Result<ApplyResponse>
        +recover(req): Result<RecoverResponse>
    }

    class BlobUseCaseImpl {
        +exists(blob_id): Result<bool>
        +append_chunk(blob_id, chunk): Result<()>
        +commit(blob_id): Result<()>
        +abort(blob_id): Result<()>
        +fetch(blob_id): Result<BlobStream>
    }

    class NodeIdentityUseCaseImpl {
        +ensure(configured): Result<Uuid>
    }
}

package "crates/core::service" {
    class AccordConsensusCoordinatorService {
        +coordinate(command): Result<CommandResult>
        -recover_and_complete()
        -complete_from_commit()
        -apply_local()
    }
}

package "crates/core::client" {
    class ConsensusTransportClient <<tonic клиент>> {
        +pre_accept(req)
        +accept(req)
        +commit(req)
        +apply(req)
        +recover(req)
    }

    class BlobClient <<tonic клиент>> {
        +push(blob_id, size, sha256, data)
        +fetch(blob_id)
    }
}

package "crates/core::repository" {
    class SqliteObjectMetadataRepository {
        +load(key)
        +store(metadata)
        +delete(key)
    }

    class SqliteConsensusJournal {
        +load(command_id)
        +check_conflicts_and_record_pre_accepted()
        +record_ballot()
        +record_accepted()
        +record_committed()
        +record_applied()
        +list_by_state(state)
        +max_sequence(node_id)
    }

    class FileSystemBlobRepository {
        +append_chunk(blob_id, chunk)
        +commit(blob_id)
        +abort(blob_id)
        +open_reader(blob_id)
        +exists(blob_id)
        +delete(blob_id)
    }

    class FileSystemNodeIdentityRepository {
        +load()
        +store(node_id)
    }
}

package "crates/core::domain" {
    enum ObjectCommand {
        Read
        Write
        Cas
        Delete
    }

    enum CommandResult {
        Read
        Write
        Cas
        Delete
    }

    class ObjectMetadata {
        +key: ObjectKey
        +version: ObjectVersion
        +blob_id: BlobId
        +sha256: Sha256Digest
        +size: u64
        +last_modified_ms: u64
    }

    class StoredObject {
        +metadata: ObjectMetadata
        +blob: BlobStream
    }

    class CommandId {
        +origin_node_id: NodeId
        +sequence: u64
    }

    class Ballot {
        +round: u64
        +node_id: NodeId
    }

    class LogicalTimestamp

    enum JournalState {
        PreAccepted
        Accepted
        Committed
        Applied
    }
}

package "crates/core::proto" {
    class mappers {
        +pre_accept_req_to_proto()
        +pre_accept_req_to_domain()
        +apply_res_to_proto()
        +apply_res_to_domain()
        +object_command_to_proto()
        +command_result_to_domain()
    }

    class consensus_proto <<prost>> {
        +PreAcceptRequest
        +AcceptRequest
        +CommitRequest
        +ApplyRequest
        +RecoverRequest
    }

    class blob_proto <<prost>> {
        +StoreBlobHeader
        +StoreBlobChunk
        +StoreBlobFooter
        +FetchBlobRequest
    }
}

package "crates/so3-maelstrom" {
    class SharedRuntime {
        +is_coordinator(): bool
        +coordinator_id(): &str
        +send_message()
    }

    class SharedState {
        +node_id: String
        +pending_consensus: HashMap
        +pending_blobs: HashMap
        +next_msg_id: AtomicU64
    }

    class MaelstromService {
        +handle_read(msg_id, key)
        +handle_write(msg_id, key, value)
        +handle_cas(msg_id, key, from, to, create_if_not_exists)
    }

    class MaelstromConsensusPeerClient {
        +pre_accept(req)
        +accept(req)
        +commit(req)
        +apply(req)
        +recover(req)
    }

    class MaelstromBlobPeerClient {
        +push(blob_id, size, sha256, data)
        +fetch(blob_id)
    }
}

main --> config
config --> NodeConfig
main --> Node
Node *-- NodeConfig
NodeConfig o-- ClusterConfig
ClusterConfig o-- PeerConfig

Node --> SqliteObjectMetadataRepository : открывает
Node --> SqliteConsensusJournal : открывает
Node --> FileSystemBlobRepository : открывает
Node --> FileSystemNodeIdentityRepository : идентичность
Node --> ObjectUseCaseImpl : связывает
Node --> InboundConsensusUseCaseImpl : связывает
Node --> BlobUseCaseImpl : связывает
BoundNode --> AxumS3Server : S3-подобный API
BoundNode --> TonicRpcServer : приватный RPC

AxumS3Server --> ObjectApiController
ObjectApiController --> ObjectUseCaseImpl
TonicRpcServer --> ConsensusTransportService
TonicRpcServer --> BlobService
ConsensusTransportService --> InboundConsensusUseCaseImpl
ConsensusTransportService --> mappers
BlobService --> BlobUseCaseImpl
BlobService --> blob_proto

ObjectUseCaseImpl --> AccordConsensusCoordinatorService
ObjectUseCaseImpl --> FileSystemBlobRepository
ObjectUseCaseImpl --> BlobClient

AccordConsensusCoordinatorService --> SqliteConsensusJournal
AccordConsensusCoordinatorService --> SqliteObjectMetadataRepository
AccordConsensusCoordinatorService --> FileSystemBlobRepository
AccordConsensusCoordinatorService --> ConsensusTransportClient
AccordConsensusCoordinatorService --> BlobClient
ConsensusTransportClient --> mappers
BlobClient --> blob_proto
AccordConsensusCoordinatorService ..> ObjectCommand
AccordConsensusCoordinatorService ..> CommandResult
AccordConsensusCoordinatorService ..> CommandId
AccordConsensusCoordinatorService ..> Ballot
AccordConsensusCoordinatorService ..> LogicalTimestamp

InboundConsensusUseCaseImpl --> SqliteConsensusJournal
InboundConsensusUseCaseImpl --> SqliteObjectMetadataRepository
InboundConsensusUseCaseImpl --> FileSystemBlobRepository
InboundConsensusUseCaseImpl --> BlobClient

SqliteConsensusJournal --> JournalState
StoredObject *-- ObjectMetadata
CommandResult --> ObjectMetadata

SharedRuntime *-- SharedState
SharedRuntime --> MaelstromService
SharedRuntime --> InboundConsensusUseCaseImpl
SharedRuntime --> FileSystemBlobRepository
MaelstromService --> ObjectUseCaseImpl
AccordConsensusCoordinatorService --> MaelstromConsensusPeerClient
ObjectUseCaseImpl --> MaelstromBlobPeerClient
MaelstromConsensusPeerClient --> mappers

note right of AccordConsensusCoordinatorService
Текущие фазы:
- локальная запись PreAccepted
- PreAccept другим узлам
- необязательный Accept
- повтор Commit до кворума
- локальный Apply
- Apply другим узлам в фоновых задачах
end note

note bottom of SharedRuntime
Адаптер Maelstrom:
- детерминированный лидер = node_ids.first()
- followers пересылают клиентские команды
- consensus payloads используют core protobuf
- blob payloads являются одиночными JSON byte arrays
- SharedState хранит pending consensus/blob,
  SharedRuntime хранит pending forward
end note

@enduml
