@startuml
!pragma layout smetana

top to bottom direction
skinparam packageStyle rectangle

package "crates/so3" {
    class Main <<bin>> {
        +main()
        +run()
    }
}

package "crates/core::node" {
    class Node {
        -config: NodeConfig
        -object_server: ObjectServer
        -rpc_server: RpcServer
        -state_machine: Arc<LocalStateMachine>
        +new(config: NodeConfig): Result<Node>
        +run(cancellation_token): Result<()>
    }

    class NodeConfig {
        +node_id: Uuid
        +object_api_addr: SocketAddr
        +rpc_api_addr: SocketAddr
        +object_request_timeout: Duration
        +data_dir: PathBuf
        +cluster: ClusterConfig
        +from_env(): Result<NodeConfig>
    }

    class ClusterConfig {
        +peers: Vec<SocketAddr>
    }
}

package "crates/core::object_server" {
    class ObjectServer {
        +new(): ObjectServer
        +run(listener, config, state_machine, cancellation_token): Result<()>
    }

    class ObjectApiState {
        +state_machine: Arc<LocalStateMachine>
        +request_timeout: Duration
    }

    class WriteQuery {
        +expected_version: Option<i64>
    }

    class WriteResponse {
        +key: String
        +version: i64
        +checksum: String
        +content_length: u64
    }

    class ErrorResponse {
        +error: String
        +detail: String
    }

    class ApiError
}

package "crates/core::rpc_server" {
    class RpcServer {
        +new(): RpcServer
        +run(listener, cancellation_token): Result<()>
    }

    class ConsensusTransport <<generated proto>>
}

package "crates/core::consensus" {
    class LocalStateMachine {
        -repository: Arc<ObjectRepository>
        +new(repository): LocalStateMachine
        +execute(command: ObjectCommand): Result<ObjectResult>
    }
}

package "crates/core::storage" {
    interface ObjectRepository {
        +read(key): Result<Option<StoredObject>>
        +write(key, value): Result<StoredObject>
        +cas(key, expected_version, value): Result<CasWriteOutcome>
    }

    class PersistentObjectStore {
        -pool: SqlitePool
        -blob_dir: PathBuf
        -write_lock: Mutex<()>
        +open(data_dir): Result<PersistentObjectStore>
    }

    enum CasWriteOutcome {
        Applied
        NotFound
        Mismatch
    }
}

package "crates/core::domain" {
    class So3Error
    class So3Result~T~

    class ObjectKey {
        +new(value): Result<ObjectKey>
        +as_str(): &str
    }

    class ObjectVersion {
        +initial(): ObjectVersion
        +next(): ObjectVersion
        +get(): i64
    }

    class ObjectRecord {
        +key: ObjectKey
        +version: ObjectVersion
        +blob_id: String
        +content_length: u64
        +checksum: String
        +updated_at_unix_ms: u64
    }

    class StoredObject {
        +record: ObjectRecord
        +value: Vec<u8>
    }

    enum ObjectCommand {
        Read
        Write
        Cas
    }

    class ReadCommand {
        +key: ObjectKey
    }

    class WriteCommand {
        +key: ObjectKey
        +value: Vec<u8>
    }

    class CasCommand {
        +key: ObjectKey
        +expected_version: ObjectVersion
        +value: Vec<u8>
    }

    enum ObjectResult {
        Read
        Write
        Cas
    }

    class ReadResult {
        +object: Option<StoredObject>
    }

    class WriteResult {
        +object: StoredObject
    }

    enum CasResult {
        Applied
        NotFound
        Mismatch
    }
}

Main --> NodeConfig : loads
Main --> Node : creates/runs

Node *-- NodeConfig
Node *-- ObjectServer
Node *-- RpcServer
Node --> LocalStateMachine

NodeConfig o-- ClusterConfig

ObjectServer --> ObjectApiState
ObjectServer --> NodeConfig
ObjectApiState --> LocalStateMachine
ObjectServer ..> WriteQuery
ObjectServer ..> WriteResponse
ObjectServer ..> ErrorResponse
ObjectServer ..> ApiError
ObjectServer ..> ObjectCommand
ObjectServer ..> ObjectResult

RpcServer ..> ConsensusTransport : placeholder for future service impl

LocalStateMachine --> ObjectRepository
LocalStateMachine ..> ObjectCommand
LocalStateMachine ..> ObjectResult
LocalStateMachine ..> CasWriteOutcome

ObjectRepository <|.. PersistentObjectStore
PersistentObjectStore ..> So3Error
So3Result ..> So3Error

ObjectCommand --> ReadCommand
ObjectCommand --> WriteCommand
ObjectCommand --> CasCommand
ObjectResult --> ReadResult
ObjectResult --> WriteResult
ObjectResult --> CasResult

ObjectRecord --> ObjectKey
ObjectRecord --> ObjectVersion
StoredObject *-- ObjectRecord
ReadCommand --> ObjectKey
WriteCommand --> ObjectKey
CasCommand --> ObjectKey
CasCommand --> ObjectVersion
CasResult --> ObjectVersion
WriteResult --> StoredObject
ReadResult --> StoredObject
CasWriteOutcome --> StoredObject
CasWriteOutcome --> ObjectVersion

@enduml
