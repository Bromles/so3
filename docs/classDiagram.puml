@startuml
!pragma layout smetana

top to bottom direction

package bins {
    class NodeMain <<bin>> {
        +main()
    }
}

package "crates/node" {
    class Node {
        -state: Arc<AppState>
        -s3: Arc<S3Server>
        -rpc: Arc<RPCServer>
        +run(): Result
    }

    class NodeBuilder {
        +from_config(cfg: NodeConfig): NodeBuilder
        +build(): Result<Node>
    }

    class NodeConfig {
        +node_id: NodeId
        +s3_bind: SocketAddr
        +rpc_bind: SocketAddr
        +meta_storage: MetaStorageConfig
        +blob_storage: BlobStorageConfig
        +cluster: ClusterConfig
    }

    class MetaStorageConfig {
        +kind: String
        +path: String
    }

    class BlobStorageConfig {
        +kind: String
        +root_dir: String
    }

    class ClusterConfig {
        +peers: List<PeerAddr>
        +replication_factor: int
    }
}

package "crates/core" {
    class AppState {
        +core: Arc<Services>
        +node_id: NodeId
        +cluster: ClusterConfig
    }

    class Services {
        +auth: Arc<AuthService>
        +objects: Arc<ObjectService>
        +buckets: Arc<BucketService>
        +cluster: Arc<ClusterService>
    }

    interface AuthService {

    }

    interface ObjectService {

    }

    interface BucketService {

    }

    interface ClusterService {

    }

    class AuthServiceImpl {

    }

    class ObjectServiceImpl {

    }

    class BucketServiceImpl {

    }

    class ClusterServiceImpl {

    }

    AuthService <|.. AuthServiceImpl
    ObjectService <|.. ObjectServiceImpl
    BucketService <|.. BucketServiceImpl
    ClusterService <|.. ClusterServiceImpl
}

package "crates/domain" {
    class NodeId
    class ObjectMeta {
        +etag: String
        +size_bytes: long
        +content_type: String
        +last_modified: Timestamp
        +blob_id: String
    }

    class BucketName
    class ObjectKey
    class BlobId
}

package "crates/storage-meta" {
    interface MetaStorage {
        +put_object_meta(bucket: BucketName, key: ObjectKey, meta: ObjectMeta): Result
        +get_object_meta(bucket: BucketName, key: ObjectKey): Result<ObjectMeta?>
    }

    class SQLiteMetaStorage {
        -path: String
    }

    class InMemMetaStorage {
        -map: HashMap
    }

    MetaStorage <|.. SQLiteMetaStorage
    MetaStorage <|.. InMemMetaStorage
}

package "crates/storage-blob" {
    interface BlobStorage {
        +put_blob(blob_id: BlobId, data: Bytes): Result
        +get_blob(blob_id: BlobId): Result<Bytes?>
    }

    class FsBlobStorage {
        -root_dir: String
    }

    class InMemBlobStorage {
        -map: HashMap
    }

    BlobStorage <|.. FsBlobStorage
    BlobStorage <|.. InMemBlobStorage
}

package "crates/consensus" {
    interface Consensus {
        +submit(cmd: Command): Result<TxnId>
        +read(txn_id: TxnId): Result<TxnState>
    }

    class Command {
        +kind: CommandKind
        +key: CommandKey
        +payload: Bytes
    }

    class SingleNodeConsensus
    class AccordConsensus

    Consensus <|.. SingleNodeConsensus
    Consensus <|.. AccordConsensus
}

package "crates/api-s3" {
    class S3API {
        -s3: S3Controller
        +build_router(state: Arc<AppState>): Router
    }

    class S3Controller {
        +put_object(state: Arc<AppState>): Response
        +get_object(state: Arc<AppState>): Response
    }
}

package "crates/transport-http" {
    interface S3Server {
        +run(state: Arc<AppState>, shutdown: Shutdown): Result
    }

    class AxumS3Server {
        -bind: SocketAddr
    }

    S3Server <|..AxumS3Server
}

package "crates/api-rpc" {
    interface NodeRPC {
        +ping(): String
        +replicate(): Result
    }

    class NodeRPCImpl {
        -core: Arc<Services>
    }

    NodeRPC <|.. NodeRPCImpl
}

package "crates/transport-rpc" {
    interface RPCServer {
        +run(state: Arc<AppState>, shutdown: Shutdown): Result
    }

    class TonicRPCServer {
        -bind: SocketAddr
    }

    RPCServer <|.. TonicRPCServer
}

NodeMain --> NodeConfig: loads
NodeMain --> NodeBuilder: builds
NodeBuilder --> Node: creates

NodeConfig o-- ClusterConfig
NodeConfig o-- MetaStorageConfig
NodeConfig o-- BlobStorageConfig
NodeConfig --> NodeId

Node --> AppState
Node --> S3Server
Node --> RPCServer

AppState --> NodeId
AppState o-- ClusterConfig

AppState --> Services
Services --> MetaStorage
Services --> BlobStorage
Services --> Consensus
Services ..> BucketName
Services ..> ObjectKey

ObjectMeta --> BucketName
ObjectMeta --> ObjectKey
ObjectMeta --> BlobId

MetaStorage ..> BucketName
MetaStorage ..> ObjectKey
MetaStorage ..> ObjectMeta

BlobStorage ..> BlobId

S3API --> S3Controller
S3Controller ..> BucketName
S3Controller ..> ObjectKey

AxumS3Server ..> S3API: serves

TonicRPCServer ..> NodeRPC: serves
NodeRPCImpl --> Services
NodeRPCImpl --> NodeId
NodeRPC ..> BlobId

@enduml
