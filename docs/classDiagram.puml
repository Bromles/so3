@startuml
!pragma layout smetana

top to bottom direction
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam linetype ortho

package "crates/so3" {
    class Main <<bin>> {
        +main()
        +run()
    }
}

package "crates/core::node" {
    class Node {
        -config: NodeConfig
        -object_server: ObjectServer
        -rpc_server: RpcServer
        -object_service: Arc<ObjectService>
        +new(config: NodeConfig): Result<Node>
        +run(cancellation_token): Result<()>
    }

    class NodeConfig {
        +node_id: Uuid
        +object_api_addr: SocketAddr
        +rpc_api_addr: SocketAddr
        +object_request_timeout: Duration
        +data_dir: PathBuf
        +cluster: ClusterConfig
        +from_env(): Result<NodeConfig>
        +from_env_with(get_var): Result<NodeConfig>
    }

    class ClusterConfig {
        +peers: Vec<SocketAddr>
    }

    class "fail_fast_join(...)" as FailFastJoin <<internal fn>>
    class "flatten_join(...)" as FlattenJoin <<internal fn>>
}

package "crates/core::object_server" {
    class ObjectServer {
        +new(): ObjectServer
        +run(listener, config, service, cancellation_token): Result<()>
    }

    class ObjectService {
        -state_machine: Arc<LocalStateMachine>
        +new(state_machine): ObjectService
        +read(key): Result<Option<StoredObject>>
        +write(key, value): Result<StoredObject>
        +cas(key, expected_version, value): Result<CasResult>
    }

    class ObjectApiState {
        +service: Arc<ObjectService>
        +request_timeout: Duration
    }

    class WriteQuery {
        +expected_version: Option<i64>
    }

    class WriteResponse {
        +key: String
        +version: i64
        +checksum: String
        +content_length: u64
    }

    class ErrorResponse {
        +error: String
        +detail: String
    }

    class ApiError
    class "object_controller(...)" as ObjectController <<router fn>>
    class "handle_get(...)" as HandleGet <<handler fn>>
    class "handle_put(...)" as HandlePut <<handler fn>>
}

package "crates/core::rpc_server" {
    class RpcServer {
        -handler: Arc<ConsensusTransportHandler>
        +new(handler): RpcServer
        +run(listener, cancellation_token): Result<()>
    }

    class ConsensusTransportService {
        -handler: Arc<ConsensusTransportHandler>
        +new(handler): ConsensusTransportService
        +pre_accept(request): Result<Response>
        +accept(request): Result<Response>
        +commit(request): Result<Response>
        +apply(request): Result<Response>
        +recover(request): Result<Response>
    }

    interface ConsensusTransportHandler {
        +pre_accept(request): Result<PreAcceptResponse>
        +accept(request): Result<AcceptResponse>
        +commit(request): Result<CommitResponse>
        +apply(request): Result<ApplyResponse>
        +recover(request): Result<RecoverResponse>
    }

    class RejectingConsensusTransport {
        -node_id: Arc<str>
        +new(node_id): RejectingConsensusTransport
    }

    interface ConsensusTransport <<generated proto service>>
    class ConsensusTransportServer <<generated tonic server>>
    class ConsensusTransportClient <<generated tonic client>>

    class CommandId {
        +origin_node_id: String
        +sequence: u64
    }

    class EventPayload {
        +command: bytes
    }

    class LogicalTimestamp {
        +epoch: u64
        +counter: u64
        +node_id: String
    }

    class DependencySet {
        +commands: repeated CommandId
    }

    class Ballot {
        +round: u64
        +node_id: String
    }

    class ApplyHashes {
        +transaction_hash: bytes
        +execution_hash: bytes
    }

    class LastApplied {
        +commands: repeated CommandId
    }

    enum State {
        STATE_UNDEFINED
        STATE_PRE_ACCEPTED
        STATE_ACCEPTED
        STATE_COMMITTED
        STATE_APPLIED
    }
}

package "crates/core::consensus" {
    class LocalStateMachine {
        -repository: Arc<ObjectRepository>
        +new(repository): LocalStateMachine
        +execute(command: ObjectCommand): Result<ObjectResult>
    }
}

package "crates/core::storage" {
    interface ObjectRepository {
        +read(key): Result<Option<StoredObject>>
        +write(key, value): Result<StoredObject>
        +cas(key, expected_version, value): Result<CasWriteOutcome>
    }

    class PersistentObjectStore {
        -pool: SqlitePool
        -blob_dir: PathBuf
        -write_lock: Mutex<()>
        +new(data_dir): Result<PersistentObjectStore>
        -init_schema(): Result<()>
        -migrate_to_v1(): Result<()>
        -persist_blob(value): Result<(String, u64, String)>
        -load_blob(blob_id): Result<Vec<u8>>
        -load_record(key): Result<Option<ObjectRecord>>
        -row_to_record(row): Result<ObjectRecord>
        -write_record(key, version, value): Result<StoredObject>
    }

    enum CasWriteOutcome {
        Applied(StoredObject)
        NotFound
        Mismatch { current_version }
    }

    class "read_content_length(...)" as ReadContentLength <<internal fn>>
    class "content_length_to_i64(...)" as ContentLengthToI64 <<internal fn>>
    class "checksum_hex(...)" as ChecksumHex <<internal fn>>
}

package "crates/core::domain" {
    class So3Error
    class So3Result~T~

    class ObjectKey {
        +new(value): Result<ObjectKey>
        +as_str(): &str
    }

    class ObjectVersion {
        +initial(): ObjectVersion
        +next(): ObjectVersion
        +get(): i64
    }

    class ObjectRecord {
        +key: ObjectKey
        +version: ObjectVersion
        +blob_id: String
        +content_length: u64
        +checksum: String
    }

    class StoredObject {
        +record: ObjectRecord
        +value: Vec<u8>
    }

    enum ObjectCommand {
        Read(ReadCommand)
        Write(WriteCommand)
        Cas(CasCommand)
    }

    class ReadCommand {
        +key: ObjectKey
    }

    class WriteCommand {
        +key: ObjectKey
        +value: Vec<u8>
    }

    class CasCommand {
        +key: ObjectKey
        +expected_version: ObjectVersion
        +value: Vec<u8>
    }

    enum ObjectResult {
        Read(ReadResult)
        Write(WriteResult)
        Cas(CasResult)
    }

    class ReadResult {
        +object: Option<StoredObject>
    }

    class WriteResult {
        +object: StoredObject
    }

    enum CasResult {
        Applied(StoredObject)
        NotFound
        Mismatch { current_version }
    }
}

Main --> NodeConfig : loads
Main --> Node : creates/runs

Node *-- NodeConfig
Node *-- ObjectServer
Node *-- RpcServer
Node --> ObjectService
Node ..> PersistentObjectStore : constructs local backend
Node ..> RejectingConsensusTransport : constructs current rpc handler
Node ..> FailFastJoin : orchestrates shutdown
FailFastJoin ..> FlattenJoin

NodeConfig o-- ClusterConfig

ObjectServer --> ObjectController
ObjectServer --> ObjectService
ObjectService --> LocalStateMachine
ObjectController --> ObjectApiState
ObjectController ..> HandleGet
ObjectController ..> HandlePut
ObjectApiState --> ObjectService
HandlePut ..> WriteQuery
HandlePut ..> WriteResponse
HandlePut ..> ApiError
ObjectService ..> ObjectCommand
ObjectService ..> ObjectResult
ObjectService ..> CasResult
ApiError ..> ErrorResponse
ApiError ..> So3Error

RpcServer --> ConsensusTransportServer
ConsensusTransportServer ..|> ConsensusTransport
ConsensusTransportService ..|> ConsensusTransport
RpcServer --> ConsensusTransportService
RpcServer --> ConsensusTransportHandler
ConsensusTransportService --> ConsensusTransportHandler
ConsensusTransportHandler <|.. RejectingConsensusTransport
ConsensusTransportClient ..> ConsensusTransport
ConsensusTransport ..> CommandId
ConsensusTransport ..> EventPayload
ConsensusTransport ..> LogicalTimestamp
ConsensusTransport ..> DependencySet
ConsensusTransport ..> Ballot
ConsensusTransport ..> ApplyHashes
ConsensusTransport ..> LastApplied
ConsensusTransport ..> State

LocalStateMachine --> ObjectRepository
LocalStateMachine ..> ObjectCommand
LocalStateMachine ..> ObjectResult
LocalStateMachine ..> CasWriteOutcome

ObjectRepository <|.. PersistentObjectStore
PersistentObjectStore ..> ReadContentLength
PersistentObjectStore ..> ContentLengthToI64
PersistentObjectStore ..> ChecksumHex
PersistentObjectStore ..> So3Error
So3Result ..> So3Error

ObjectCommand --> ReadCommand
ObjectCommand --> WriteCommand
ObjectCommand --> CasCommand
ObjectResult --> ReadResult
ObjectResult --> WriteResult
ObjectResult --> CasResult

ObjectRecord --> ObjectKey
ObjectRecord --> ObjectVersion
StoredObject *-- ObjectRecord
ReadCommand --> ObjectKey
WriteCommand --> ObjectKey
CasCommand --> ObjectKey
CasCommand --> ObjectVersion
CasResult --> StoredObject
CasResult --> ObjectVersion
WriteResult --> StoredObject
ReadResult --> StoredObject
CasWriteOutcome --> StoredObject
CasWriteOutcome --> ObjectVersion

note right of Node
Current composition:
- one local persistent backend
- one public HTTP object API
- one private gRPC RPC server
- object API goes through ObjectService
- rpc API goes through ConsensusTransportHandler
- no separate consensus engine yet
end note

note right of PersistentObjectStore
Current durability model:
- SQLite stores current object metadata
- blobs are immutable files on local FS
- blob is persisted before metadata points to it
- schema version is explicit via PRAGMA user_version
- write/cas are serialized with write_lock
end note

note right of LocalStateMachine
Current state machine scope:
- deterministic command dispatch
- delegates persistence through ObjectRepository
- not yet backed by replicated Accord log/recovery state
end note

note right of RpcServer
Current RPC state:
- tonic transport is wired
- handlers delegate into ConsensusTransportHandler
- default node wiring uses RejectingConsensusTransport
- pre_accept/accept/recover nack conservatively
- commit/apply return FAILED_PRECONDITION
end note

note right of FailFastJoin
If either server task finishes first,
the root CancellationToken is cancelled
and the peer task is awaited.
end note

@enduml
